{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "windows": {
        "runtimeExecutable": "powershell.exe",
        "runtimeArgs": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "if (!(Get-PSDrive -Name Y -ErrorAction SilentlyContinue)) { subst Y: '${workspaceFolder}' }; Set-Location Y:; if (Get-Command pnpm -ErrorAction SilentlyContinue) { pnpm run start } else { npm.cmd run start }"
        ]
      },
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "pnpm", "run", "start"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/.vite/build/**/*.js", "Y:/.vite/build/**/*.js"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true
    },
    {
      "name": "Debug Main Process (Proxyman)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "windows": {
        "runtimeExecutable": "powershell.exe",
        "runtimeArgs": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "if (!(Get-PSDrive -Name Y -ErrorAction SilentlyContinue)) { subst Y: '${workspaceFolder}' }; Set-Location Y:; if (Get-Command pnpm -ErrorAction SilentlyContinue) { pnpm run start } else { npm.cmd run start }"
        ]
      },
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "pnpm", "run", "start"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/.vite/build/**/*.js", "Y:/.vite/build/**/*.js"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "env": {
        "NODE_USE_ENV_PROXY": "1",
        "HTTP_PROXY": "http://127.0.0.1:9090",
        "HTTPS_PROXY": "http://127.0.0.1:9090",
        "ALL_PROXY": "http://127.0.0.1:9090",
        "NO_PROXY": "localhost,127.0.0.1,::1",
        "ELECTRON_PROXY_SERVER": "http://127.0.0.1:9090",
        "ELECTRON_PROXY_BYPASS_LIST": "<local>;localhost;127.0.0.1;::1",
        "DEBUG_PROXY_TRACE": "1",
        "NODE_EXTRA_CA_CERTS": "${env:APPDATA}\\Proxyman\\certificate\\certs\\ca.pem",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    {
      "name": "Package & Install Official Release",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "windows": {
        "runtimeExecutable": "powershell.exe",
        "runtimeArgs": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "if (!(Get-PSDrive -Name Y -ErrorAction SilentlyContinue)) { subst Y: '${workspaceFolder}' }; Set-Location Y:; npm.cmd run install:official"
        ]
      },
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "install:official"],
      "console": "integratedTerminal"
    },
    {
      "name": "Install Official Release (Skip Build)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "windows": {
        "runtimeExecutable": "powershell.exe",
        "runtimeArgs": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "if (!(Get-PSDrive -Name Y -ErrorAction SilentlyContinue)) { subst Y: '${workspaceFolder}' }; Set-Location Y:; npm.cmd run install:official:quick"
        ]
      },
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "install:official:quick"],
      "console": "integratedTerminal"
    }
  ]
}
