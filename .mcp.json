{
  "$schema": "https://json.schemastore.org/mcp-config.json",
  "mcpServers": {
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "--db-path",
        "${env:APPDATA}/Antigravity/User/globalStorage/state.vscdb"
      ],
      "disabled": true
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "disabled": true
    }
  }
}
